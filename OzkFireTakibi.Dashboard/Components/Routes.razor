<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        @if (routeData.PageType == typeof(Pages.Login))
        {
            <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.EmptyLayout)" />
        }
        else
        {
            <AuthorizeView>
                <Authorized>
                    @if (routeData.PageType == typeof(Pages.Reports))
                    {
                        <AuthorizeView Policy="@ReportPolicies.CanImportReports" Context="reportPolicyContext">
                            <Authorized>
                                <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
                            </Authorized>
                            <NotAuthorized>
                                <LayoutView Layout="typeof(Layout.MainLayout)">
                                    <div class="notification is-danger is-light">Rapor yükleme ekranı için yetkiniz bulunmamaktadır.</div>
                                </LayoutView>
                            </NotAuthorized>
                        </AuthorizeView>
                    }
                    else if (routeData.PageType == typeof(Pages.ExcuseStores))
                    {
                        <AuthorizeView Policy="@ReportPolicies.CanManageExcuseStores" Context="storePolicyContext">
                            <Authorized>
                                <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
                            </Authorized>
                            <NotAuthorized>
                                <LayoutView Layout="typeof(Layout.MainLayout)">
                                    <div class="notification is-danger is-light">Mağaza kapsamı ekranı için yetkiniz bulunmamaktadır.</div>
                                </LayoutView>
                            </NotAuthorized>
                        </AuthorizeView>
                    }
                    else
                    {
                        <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
                    }
                </Authorized>
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
                <Authorizing>
                    <div class="is-flex is-justify-content-center p-6">
                        <progress class="progress is-primary is-small" max="100">Oturum kontrol ediliyor</progress>
                    </div>
                </Authorizing>
            </AuthorizeView>
        }
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
