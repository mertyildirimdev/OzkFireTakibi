<div class="buttons mb-3">
    <button class="button is-small is-light" type="button" @onclick="ToggleAll">
        <span class="icon is-small" aria-hidden="true">
            <i class="fas @(AreAllGroupsExpanded ? "fa-compress-alt" : "fa-expand-alt")"></i>
        </span>
        <span>@(AreAllGroupsExpanded ? "Tüm grupları kapat" : "Tüm grupları aç")</span>
    </button>
</div>

<div class="table-container report-table-container">
    <table class="table is-fullwidth is-hoverable is-striped is-narrow">
        <thead>
            <tr>
                @for (var columnIndex = 0; columnIndex < Columns.Count; columnIndex++)
                {
                    var column = Columns[columnIndex];
                    <th class="@(column.DataType == ColumnDataType.Text ? null : "has-text-right")">
                        <ColumnFilterMenu Column="column"
                                          AlignRight="@(columnIndex >= 2)"
                                          Values="GetDistinctValues(column)"
                                          ActiveValues="GetActiveValues(column.Key)"
                                          OnSort="direction => SortAsync(column.Key, direction)"
                                          OnFilter="values => FilterAsync(column.Key, values)" />
                    </th>
                }
                @if (CanRequestExcuse)
                {
                    <th class="has-text-right">İşlem</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var group in GroupOrder)
            {
                var rows = MatchingRows(group);
                var isExpanded = _expandedGroups.Contains(group);
                <tr class="has-background-info-light group-row">
                    <th colspan="@ColumnCount">
                        <button class="button is-ghost is-fullwidth is-justify-content-space-between has-text-left"
                                type="button"
                                aria-expanded="@(isExpanded ? "true" : "false")"
                                @onclick="() => Toggle(group)">
                            <span class="icon-text">
                                <span class="icon"><i class="fas @(isExpanded ? "fa-chevron-down" : "fa-chevron-right")"></i></span>
                                <span>
                                    <strong>@GroupTitle(group)</strong>
                                </span>
                            </span>
                            <span class="tag is-info is-light">@CountLabel(group, rows.Count)</span>
                        </button>
                    </th>
                </tr>

                @if (isExpanded)
                {
                    @foreach (var row in SortRows(rows).Skip((Page(group) - 1) * PageSize).Take(PageSize))
                    {
                        <tr>
                            @foreach (var column in Columns)
                            {
                                <td class="@(column.DataType == ColumnDataType.Text ? null : "has-text-right")">
                                    <button class="button is-ghost is-small p-0 has-text-text" type="button"
                                            title="@($"{column.Label}: {column.Format(row)} değerine göre filtrele")"
                                            aria-label="@($"{column.Label}: {column.Format(row)} değerine göre filtrele")"
                                            @onclick="() => FilterAsync(column.Key, new HashSet<string> { column.ValueKey(row) })">
                                        @column.Format(row)
                                    </button>
                                </td>
                            }
                            @if (CanRequestExcuse)
                            {
                                <td class="has-text-right">
                                    @if (CanCreateExcuse(row))
                                    {
                                        <button class="button is-small is-warning is-light" type="button" @onclick="() => OnExcuseRequested.InvokeAsync(row)">
                                            <span class="icon"><i class="fas fa-comment-dots"></i></span><span>Mazeret iste</span>
                                        </button>
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
                    @if (isExpanded && rows.Count > PageSize)
                    {
                        <tr><td colspan="@ColumnCount">
                            <nav class="pagination is-small" aria-label="@($"{GroupTitle(group)} sayfaları")">
                                <button class="pagination-previous" disabled="@(Page(group) <= 1)" @onclick="() => SetPage(group, Page(group) - 1)">Önceki</button>
                                <button class="pagination-next" disabled="@(Page(group) * PageSize >= rows.Count)" @onclick="() => SetPage(group, Page(group) + 1)">Sonraki</button>
                                <span class="pagination-list">@rows.Count satır · Sayfa @Page(group) / @((rows.Count + PageSize - 1) / PageSize)</span>
                            </nav>
                        </td></tr>
                    }
            }
        </tbody>
    </table>
</div>

<div class="is-flex is-justify-content-space-between is-align-items-center mt-3">
    <p class="is-size-7 has-text-grey">
        <strong>@FilteredRowCount.ToString("N0")</strong> Excel satırı eşleşiyor.
        Kırılımlar bağımsız açılır; her sayfada en fazla @PageSize satır gösterilir. Arama ve filtreler tüm satırlarda çalışır.
    </p>
</div>

@code {
    [Parameter, EditorRequired] public ReportSnapshot Snapshot { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<ColumnDefinition> Columns { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, IReadOnlySet<string>> Filters { get; set; }
        = new Dictionary<string, IReadOnlySet<string>>();
    [Parameter] public SortRule? Sort { get; set; }
    [Parameter] public string GlobalSearch { get; set; } = string.Empty;
    [Parameter] public EventCallback<SortRule> OnSortChanged { get; set; }
    [Parameter] public EventCallback<ColumnFilterChange> OnFilterChanged { get; set; }
    [Parameter] public bool CanRequestExcuse { get; set; }
    [Parameter] public EventCallback<ReportRowEntity> OnExcuseRequested { get; set; }

    private static readonly ReportRowType[] GroupOrder =
    [
        ReportRowType.General,
        ReportRowType.CategorySummary,
        ReportRowType.StoreSummary,
        ReportRowType.StoreCategory,
        ReportRowType.ProductSummary,
        ReportRowType.StoreProduct
    ];

    private HashSet<ReportRowType> _expandedGroups = [ReportRowType.General, ReportRowType.StoreSummary];
    private const int PageSize = 50;
    private readonly Dictionary<ReportRowType, int> _pages = [];
    private string? _filterSignature;
    private int Page(ReportRowType group) => _pages.GetValueOrDefault(group, 1);
    private void SetPage(ReportRowType group, int page) => _pages[group] = Math.Max(1, page);
    private long _snapshotImportId;
    private int ColumnCount => Columns.Count + (CanRequestExcuse ? 1 : 0);
    private bool HasActiveFiltering => !string.IsNullOrWhiteSpace(GlobalSearch) || Filters.Count > 0;
    private int FilteredRowCount => Snapshot.Rows.Count(row => MatchesGlobalSearch(row) && MatchesFilters(row));
    private bool AreAllGroupsExpanded => GroupOrder.All(_expandedGroups.Contains);

    protected override void OnParametersSet()
    {
        if (_snapshotImportId != Snapshot.Import.Id)
        {
            _snapshotImportId = Snapshot.Import.Id;
            _expandedGroups = [ReportRowType.General, ReportRowType.StoreSummary];
            _pages.Clear();
        }
        var signature = System.Text.Json.JsonSerializer.Serialize(new
        {
            GlobalSearch, Sort,
            Filters = Filters.OrderBy(x => x.Key).Select(x => new { x.Key, Values = x.Value.Order().ToArray() }).ToArray()
        });
        if (_filterSignature != signature)
        {
            _filterSignature = signature;
            _pages.Clear();
            if (HasActiveFiltering) _expandedGroups = new HashSet<ReportRowType>(GroupOrder);
        }
    }

    private IReadOnlyList<ReportRowEntity> MatchingRows(ReportRowType group) => Snapshot.Rows
        .Where(row => row.RowType == group)
        .Where(MatchesGlobalSearch)
        .Where(row => MatchesFilters(row))
        .ToArray();

    private IReadOnlyList<DistinctValue> GetDistinctValues(ColumnDefinition column)
    {
        return Snapshot.Rows
            .Where(MatchesGlobalSearch)
            .Where(row => MatchesFilters(row, column.Key))
            .GroupBy(column.ValueKey)
            .Select(group => new DistinctValue(
                group.Key,
                string.IsNullOrWhiteSpace(group.Key) ? "Tümü" : column.Format(group.First()),
                group.Count()))
            .OrderBy(value => value.Label, StringComparer.CurrentCultureIgnoreCase)
            .ToArray();
    }

    private IReadOnlySet<string>? GetActiveValues(string columnKey) => Filters.GetValueOrDefault(columnKey);

    private bool MatchesFilters(ReportRowEntity row, string? excludedColumn = null)
    {
        foreach (var filter in Filters)
        {
            if (filter.Key == excludedColumn) continue;
            var column = ReportColumnCatalog.All.First(item => item.Key == filter.Key);
            if (!filter.Value.Contains(column.ValueKey(row))) return false;
        }

        return true;
    }

    private bool MatchesGlobalSearch(ReportRowEntity row)
    {
        if (string.IsNullOrWhiteSpace(GlobalSearch)) return true;
        return new[]
            {
                row.SourceReportType, row.CategoryCode, row.CategoryName, row.StockCode, row.StockName,
                row.StoreName, row.StoreNumber?.ToString()
            }
            .Any(value => value?.Contains(GlobalSearch, StringComparison.CurrentCultureIgnoreCase) == true);
    }

    private IEnumerable<ReportRowEntity> SortRows(IEnumerable<ReportRowEntity> rows)
    {
        if (Sort is null) return rows.OrderBy(row => row.SourceRowNumber);
        var column = ReportColumnCatalog.All.First(item => item.Key == Sort.ColumnKey);
        return Sort.Direction == SortDirection.Ascending
            ? rows.OrderBy(column.Value, ObjectValueComparer.Instance).ThenBy(row => row.SourceRowNumber)
            : rows.OrderByDescending(column.Value, ObjectValueComparer.Instance).ThenBy(row => row.SourceRowNumber);
    }

    private void Toggle(ReportRowType group)
    {
        if (!_expandedGroups.Add(group))
        {
            _expandedGroups.Remove(group);
        }
    }

    private void ToggleAll()
    {
        _expandedGroups = AreAllGroupsExpanded
            ? []
            : new HashSet<ReportRowType>(GroupOrder);
    }
    private Task SortAsync(string columnKey, SortDirection direction) => OnSortChanged.InvokeAsync(new SortRule(columnKey, direction));
    private Task FilterAsync(string columnKey, IReadOnlySet<string>? values) => OnFilterChanged.InvokeAsync(new ColumnFilterChange(columnKey, values));

    private string CountLabel(ReportRowType group, int filteredCount)
    {
        var total = Snapshot.Rows.Count(row => row.RowType == group);
        return HasActiveFiltering ? $"{filteredCount:N0} / {total:N0}" : $"{total:N0} satır";
    }

    private static string GroupTitle(ReportRowType group) => group switch
    {
        ReportRowType.General => "Genel Durum",
        ReportRowType.CategorySummary => "Genel Durum Grup Detaylı",
        ReportRowType.StoreSummary => "Şubeler Genel Durum",
        ReportRowType.StoreCategory => "Şubeler Grup Detaylı",
        ReportRowType.ProductSummary => "Stoklar Genel",
        ReportRowType.StoreProduct => "Şubeler Stok Detaylı",
        _ => group.ToString()
    };

    private static bool CanCreateExcuse(ReportRowEntity row) => row.RowType is
        ReportRowType.StoreCategory or ReportRowType.StoreProduct;

    private sealed class ObjectValueComparer : IComparer<object?>
    {
        public static readonly ObjectValueComparer Instance = new();

        public int Compare(object? x, object? y)
        {
            if (ReferenceEquals(x, y)) return 0;
            if (x is null) return 1;
            if (y is null) return -1;
            if (x is decimal xDecimal && y is decimal yDecimal) return xDecimal.CompareTo(yDecimal);
            if (x is int xInt && y is int yInt) return xInt.CompareTo(yInt);
            return StringComparer.CurrentCultureIgnoreCase.Compare(x.ToString(), y.ToString());
        }
    }
}
