@*
    Masaüstü ve mobil üst navigasyonda ortak kullanılan bağlantılar.
*@

@foreach (var item in navItems)
{
    <AuthorizeView Policy="@item.Policy">
        <Authorized>
            <NavLink class="navbar-item"
                     href="@item.Url"
                     Match="@item.Match"
                     ActiveClass="has-text-primary has-text-weight-semibold"
                     @onclick="HandleNavigate">
                <span class="icon-text">
                    <span class="icon" aria-hidden="true"><i class="@item.Icon"></i></span>
                    <span>@item.Title</span>
                </span>
            </NavLink>
        </Authorized>
    </AuthorizeView>
}

@code {
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private readonly NavItem[] navItems =
    [
        new("Anasayfa", "fas fa-house", "", NavLinkMatch.All),
        new("Analizler", "fas fa-chart-line", "/analizler", NavLinkMatch.Prefix),
        new("Raporlar", "fas fa-file-alt", "/raporlar", NavLinkMatch.Prefix, ReportPolicies.CanImportReports),
        new("Mazeretler", "fas fa-clipboard-question", "/mazeretler", NavLinkMatch.Prefix)
    ];

    private async Task HandleNavigate()
    {
        if (OnNavigate.HasDelegate)
        {
            await OnNavigate.InvokeAsync();
        }
    }

    private sealed record NavItem(
        string Title,
        string Icon,
        string Url,
        NavLinkMatch Match,
        string? Policy = null);
}
