<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" class="box" data-nosnippet>
    <div class="is-flex is-flex-direction-column is-align-items-center">
        <span class="loader is-size-2 components-rejoining-animation" aria-hidden="true"></span>
        <p class="components-reconnect-first-attempt-visible has-text-centered mb-0">
            Rejoining the server...
        </p>
        <p class="components-reconnect-repeated-attempt-visible has-text-centered mb-0">
            Rejoin failed... trying again in <span id="components-seconds-to-next-attempt"></span> seconds.
        </p>
        <p class="components-reconnect-failed-visible has-text-centered mb-0">
            Failed to rejoin.<br />Please retry or reload the page.
        </p>
        <button id="components-reconnect-button" class="button is-primary components-reconnect-failed-visible">
            Retry
        </button>
        <p class="components-pause-visible has-text-centered mb-0">
            The session has been paused by the server.
        </p>
        <p class="components-resume-failed-visible has-text-centered mb-0">
            Failed to resume the session.<br />Please retry or reload the page.
        </p>
        <button id="components-resume-button" class="button is-primary components-pause-visible components-resume-failed-visible">
            Resume
        </button>
    </div>
</dialog>
