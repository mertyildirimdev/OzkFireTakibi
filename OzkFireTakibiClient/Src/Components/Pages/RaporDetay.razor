@*
    Analiz Detay Sayfası (RaporDetay.razor)
    - Rapor genel metrikleri ve özet kartları (ciro, maliyet, fire oranı, kâr oranı)
    - Satır kırılım sekmeleri (Kategori Özeti, Mağaza Özeti, Mağaza x Kategori, Ürün Özeti, Mağaza x Ürün)
    - Sütun/alan seçici modal (gösterilecek Excel alanlarını özelleştirme)
    - Canlı metin arama ve sunucu taraflı sayfalama
    - Kümülatif rapor ile yan yana karşılaştırma modu
*@

@page "/analizler/{ImportId:long}"
@inherits AuthRequiredComponent
@implements IAsyncDisposable
@inject ReportImportService ReportImportService
@inject ExcuseService ExcuseService
@inject IAuthorizationService AuthorizationService
@inject IOptions<ExcuseOptions> ExcuseOptions
@using OzkFireTakibiClient.Src.Data.Entities

<PageTitle>Analiz Detayı</PageTitle>


<div class="container">
    <div class="mb-5">
        <NavLink class="button is-light is-small mb-4" href="/analizler">
            <span class="icon"><i class="fas fa-arrow-left"></i></span>
            <span>Analizlere dön</span>
        </NavLink>

        @if (detail is not null)
        {
            <div class="level">
                <div class="level-left">
                    <div>
                        <div class="is-flex is-align-items-center mb-2">
                            <h1 class="title is-3 mb-0">Analiz detayı</h1>
                            <span class="tag ml-3 @(detail.Header.IsActive ? "is-success is-light" : "is-light")">
                                @(detail.Header.IsActive ? "Aktif sürüm" : "Eski sürüm")
                            </span>
                        </div>
                        <p class="subtitle is-6 has-text-grey mb-1">@detail.Header.OriginalFileName</p>
                        <p class="is-size-7 has-text-grey">
                            @detail.Header.StartDate.ToString("dd.MM.yyyy") – @detail.Header.EndDate.ToString("dd.MM.yyyy")
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="notification is-danger is-light" role="alert">
            <span class="icon-text">
                <span class="icon"><i class="fas fa-circle-exclamation"></i></span>
                <span>@errorMessage</span>
            </span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="notification is-success is-light" role="status">@successMessage</div>
    }

    @if (isLoading && detail is null)
    {
        <progress class="progress is-primary" max="100">Yükleniyor</progress>
    }
    else if (detail is not null)
    {
        @if (detail.Header.GeneralSummary is not null)
        {
            <section class="box mb-5" aria-labelledby="summary-title">
                <div class="level is-mobile @(isGeneralSummaryExpanded ? "mb-4" : "mb-0")">
                    <div class="level-left">
                        <h2 id="summary-title" class="title is-5 mb-0">Genel sonuç</h2>
                    </div>
                    <div class="level-right">
                        <button class="button is-small is-light"
                                type="button"
                                aria-expanded="@isGeneralSummaryExpanded"
                                aria-controls="general-summary-content"
                                @onclick="ToggleGeneralSummary">
                            <span class="icon">
                                <i class="fas @(isGeneralSummaryExpanded ? "fa-chevron-up" : "fa-chevron-down")"></i>
                            </span>
                            <span>@(isGeneralSummaryExpanded ? "Daralt" : "Genişlet")</span>
                        </button>
                    </div>
                </div>
                @if (isGeneralSummaryExpanded)
                {
                    <div id="general-summary-content" class="columns is-multiline">
                    <div class="column is-half-tablet is-one-quarter-desktop">
                        <p class="heading">Mağaza satış tutarı</p>
                        <p class="title is-5">@FormatNumber(detail.Header.GeneralSummary.StoreSalesAmount)</p>
                        @if (detail.IncludeComparison)
                        {
                            <p class="is-size-7 has-text-info">Kümülatif: @FormatNumber(detail.Header.GeneralSummary.Comparison?.StoreSalesAmount)</p>
                        }
                    </div>
                    <div class="column is-half-tablet is-one-quarter-desktop">
                        <p class="heading">Satış maliyeti</p>
                        <p class="title is-5">@FormatNumber(detail.Header.GeneralSummary.CostOfSales)</p>
                        @if (detail.IncludeComparison)
                        {
                            <p class="is-size-7 has-text-info">Kümülatif: @FormatNumber(detail.Header.GeneralSummary.Comparison?.CostOfSales)</p>
                        }
                    </div>
                    <div class="column is-half-tablet is-one-quarter-desktop">
                        <p class="heading">Fire oranı</p>
                        <p class="title is-5">@FormatRate(detail.Header.GeneralSummary.WasteRate)</p>
                        @if (detail.IncludeComparison)
                        {
                            <p class="is-size-7 has-text-info">Kümülatif: @FormatRate(detail.Header.GeneralSummary.Comparison?.WasteRate)</p>
                        }
                    </div>
                    <div class="column is-half-tablet is-one-quarter-desktop">
                        <p class="heading">Fire tutarı</p>
                        <p class="title is-5">@FormatNumber(detail.Header.GeneralSummary.WasteAmount)</p>
                        @if (detail.IncludeComparison)
                        {
                            <p class="is-size-7 has-text-info">Kümülatif: @FormatNumber(detail.Header.GeneralSummary.Comparison?.WasteAmount)</p>
                        }
                    </div>
                    <div class="column is-half-tablet is-one-quarter-desktop">
                        <p class="heading">Kâr oranı</p>
                        <p class="title is-5">@FormatRate(detail.Header.GeneralSummary.ProfitRate)</p>
                        @if (detail.IncludeComparison)
                        {
                            <p class="is-size-7 has-text-info">Kümülatif: @FormatRate(detail.Header.GeneralSummary.Comparison?.ProfitRate)</p>
                        }
                    </div>
                    <div class="column is-half-tablet is-one-quarter-desktop">
                        <p class="heading">Kâr tutarı</p>
                        <p class="title is-5">@FormatNumber(detail.Header.GeneralSummary.ProfitAmount)</p>
                        @if (detail.IncludeComparison)
                        {
                            <p class="is-size-7 has-text-info">Kümülatif: @FormatNumber(detail.Header.GeneralSummary.Comparison?.ProfitAmount)</p>
                        }
                    </div>
                    <div class="column is-half-tablet is-one-quarter-desktop">
                        <p class="heading">Fire miktarı</p>
                        <p class="title is-5">@FormatNumber(detail.Header.GeneralSummary.WasteQuantity)</p>
                        @if (detail.IncludeComparison)
                        {
                            <p class="is-size-7 has-text-info">Kümülatif: @FormatNumber(detail.Header.GeneralSummary.Comparison?.WasteQuantity)</p>
                        }
                    </div>
                    </div>
                }
            </section>
        }

        <section class="box" aria-labelledby="rows-title">
            <div class="level mb-4">
                <div class="level-left">
                    <h2 id="rows-title" class="title is-5 mb-0">Excel satırları</h2>
                </div>
                <div class="level-right">
                    <div class="buttons">
                        <button class="button is-small is-light" type="button" @onclick="OpenFieldSelector">
                            <span class="icon"><i class="fas fa-table-columns"></i></span>
                            <span>Gösterilecek alanlar (@SelectedFieldKeys.Count/@fields.Length)</span>
                        </button>
                        @if (detail.Header.PeriodType == ReportPeriodType.Monthly)
                        {
                            <label class="button is-small is-light">
                                <input class="mr-2"
                                       type="checkbox"
                                       checked="@compareWithCumulative"
                                       disabled="@(isLoading || detail.Header.ComparisonSource is null)"
                                       @onchange="ToggleComparisonAsync" />
                                Kümülatif raporla karşılaştır
                            </label>
                        }
                    </div>
                </div>
            </div>

            @if (detail.IncludeComparison && detail.Header.ComparisonSource is not null)
            {
                <div class="notification is-info is-light py-3">
                    Aylık değerler <strong>@detail.Header.ComparisonSource.OriginalFileName</strong> dosyasındaki kümülatif değerlerle yan yana gösteriliyor.
                </div>
            }

            <div class="tabs is-toggle is-toggle-rounded is-small">
                <ul>
                    @foreach (var rowType in rowTypes)
                    {
                        <li class="@(selectedRowType == rowType ? "is-active" : null)">
                            <a role="button" @onclick="() => SelectRowTypeAsync(rowType)">
                                <span>@ReportDisplayNames.RowType(rowType)</span>
                                <span class="tag ml-2">@detail.Header.Count(rowType).ToString("N0")</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <section class="box mb-4" aria-labelledby="detail-filter-title">
                <div class="level is-mobile mb-4">
                    <div class="level-left">
                        <div>
                            <div class="is-flex is-align-items-center">
                                <h3 id="detail-filter-title" class="title is-6 mb-0">Filtreler</h3>
                                @if (ActiveFilterCount > 0)
                                {
                                    <span class="tag is-primary is-light ml-2">@ActiveFilterCount aktif</span>
                                }
                            </div>
                            <p class="is-size-7 has-text-grey mt-1">@ReportDisplayNames.RowType(selectedRowType) kayıtlarında arayın ve sıralayın.</p>
                        </div>
                    </div>
                    @if (HasFilterChanges)
                    {
                        <div class="level-right">
                            <button class="button is-small is-ghost" type="button" disabled="@isLoading" @onclick="ClearFiltersAsync">
                                <span class="icon"><i class="fas fa-rotate-left"></i></span>
                                <span>Sıfırla</span>
                            </button>
                        </div>
                    }
                </div>

                <div class="columns is-multiline is-variable is-2">
                    <div class="column is-12-tablet is-4-desktop">
                        <label class="label is-small" for="detail-search">Hızlı arama</label>
                        <div class="control has-icons-left">
                            <input id="detail-search"
                                   class="input is-small"
                                   type="search"
                                   maxlength="100"
                                   placeholder="Kod veya ad yazın"
                                   @bind="filters.SearchText"
                                   @bind:event="oninput"
                                   @onkeydown="HandleFilterKeyDown" />
                            <span class="icon is-small is-left"><i class="fas fa-magnifying-glass"></i></span>
                        </div>
                    </div>

                    @if (ShowStoreFilter)
                    {
                        <div class="column is-6-tablet is-2-desktop">
                            <label class="label is-small" for="store-filter">Mağaza</label>
                            <input id="store-filter" class="input is-small" type="search" maxlength="80"
                                   placeholder="No veya mağaza adı" @bind="filters.StoreText" @bind:event="oninput"
                                   @onkeydown="HandleFilterKeyDown" />
                        </div>
                    }

                    @if (ShowCategoryFilter)
                    {
                        <div class="column is-6-tablet is-2-desktop">
                            <label class="label is-small" for="category-filter">Kategori</label>
                            <input id="category-filter" class="input is-small" type="search" maxlength="80"
                                   placeholder="Kod veya kategori adı" @bind="filters.CategoryText" @bind:event="oninput"
                                   @onkeydown="HandleFilterKeyDown" />
                        </div>
                    }

                    @if (ShowProductFilter)
                    {
                        <div class="column is-6-tablet is-2-desktop">
                            <label class="label is-small" for="product-filter">Ürün</label>
                            <input id="product-filter" class="input is-small" type="search" maxlength="80"
                                   placeholder="Stok kodu veya ürün" @bind="filters.ProductText" @bind:event="oninput"
                                   @onkeydown="HandleFilterKeyDown" />
                        </div>
                    }

                    <div class="column is-6-tablet is-2-desktop">
                        <label class="label is-small" for="waste-filter">Fire durumu</label>
                        <div class="select is-small is-fullwidth">
                            <select id="waste-filter" @bind="filters.WasteFilter">
                                <option value="@ReportDetailWasteFilter.All">Tümü</option>
                                <option value="@ReportDetailWasteFilter.Loss">Fire var</option>
                                <option value="@ReportDetailWasteFilter.NoLoss">Fire yok / pozitif</option>
                            </select>
                        </div>
                    </div>

                    @if (detail.IncludeComparison)
                    {
                        <div class="column is-6-tablet is-3-desktop">
                            <label class="label is-small" for="comparison-filter">Kümülatif karşılaştırma</label>
                            <div class="select is-small is-fullwidth">
                                <select id="comparison-filter" @bind="filters.ComparisonFilter">
                                    <option value="@ReportDetailComparisonFilter.All">Tümü</option>
                                    <option value="@ReportDetailComparisonFilter.WorseThanCumulative">Kümülatiften daha yüksek fire</option>
                                </select>
                            </div>
                        </div>
                    }

                    <div class="column is-6-tablet is-2-desktop">
                        <label class="label is-small">Fire oranı (%)</label>
                        <div class="field has-addons">
                            <p class="control is-expanded">
                                <input class="input is-small" type="number" step="0.01" placeholder="Min"
                                       aria-label="En düşük fire oranı" @bind="filters.MinimumWasteRate" />
                            </p>
                            <p class="control is-expanded">
                                <input class="input is-small" type="number" step="0.01" placeholder="Maks"
                                       aria-label="En yüksek fire oranı" @bind="filters.MaximumWasteRate" />
                            </p>
                        </div>
                    </div>

                    <div class="column is-6-tablet is-3-desktop">
                        <label class="label is-small" for="sort-filter">Sıralama</label>
                        <div class="select is-small is-fullwidth">
                            <select id="sort-filter" @bind="filters.Sort">
                                <option value="@ReportDetailSort.SourceOrder">Excel satır sırası</option>
                                <option value="@ReportDetailSort.WorstWasteRate">En kötü fire oranı</option>
                                <option value="@ReportDetailSort.WorstWasteAmount">En kötü fire tutarı</option>
                                <option value="@ReportDetailSort.HighestSalesAmount">En yüksek satış tutarı</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="pt-3 is-flex is-flex-wrap-wrap is-justify-content-space-between is-align-items-center">
                    <p class="is-size-7 has-text-grey">
                        <strong>@detail.TotalRowCount.ToString("N0")</strong> kayıt gösteriliyor
                        @if (HasAppliedFilters)
                        {
                            <span> / @detail.Header.Count(selectedRowType).ToString("N0") toplam</span>
                        }
                    </p>
                    <button class="button is-primary is-small" type="button" disabled="@isLoading" @onclick="ApplyFiltersAsync">
                        <span class="icon"><i class="fas fa-filter"></i></span>
                        <span>Filtrele</span>
                    </button>
                </div>
            </section>

            @if (isLoading)
            {
                <progress class="progress is-small is-primary" max="100">Yükleniyor</progress>
            }
            else if (detail.Rows.Count == 0)
            {
                <div class="notification is-light has-text-centered">Bu filtreye uygun satır bulunamadı.</div>
            }
            else
            {
                <div class="waste-scale-legend mb-2" aria-label="Fire renk göstergesi">
                    <span class="waste-scale-swatch is-soft" aria-hidden="true"></span>
                    <span class="waste-scale-swatch is-medium" aria-hidden="true"></span>
                    <span class="waste-scale-swatch is-strong" aria-hidden="true"></span>
                    <span>Fire büyüdükçe ve mazeret eşiğini aştıkça kırmızı ton koyulaşır.</span>
                </div>
                <div class="table-container report-rows-scroll">
                    <table class="table is-fullwidth is-hoverable is-striped is-narrow">
                        <thead>
                            <tr>
                                <th rowspan="@(ShowComparisonSubheaders ? 2 : 1)">Excel satırı</th>
                                @if (detail.IncludeComparison)
                                {
                                    <th rowspan="@(ShowComparisonSubheaders ? 2 : 1)">Eşleşme</th>
                                }
                                @foreach (var field in VisibleFields)
                                {
                                    @if (detail.IncludeComparison && field.IsComparable)
                                    {
                                        <th class="has-text-centered" colspan="2">@field.Label</th>
                                    }
                                    else
                                    {
                                        <th class="@(field.IsNumeric ? "has-text-right" : null)"
                                            rowspan="@(ShowComparisonSubheaders ? 2 : 1)">@field.Label</th>
                                    }
                                }
                                @if (CanCreateManualExcuse)
                                {
                                    <th rowspan="@(ShowComparisonSubheaders ? 2 : 1)">İşlem</th>
                                }
                            </tr>
                            @if (ShowComparisonSubheaders)
                            {
                                <tr>
                                    @foreach (var field in VisibleFields.Where(column => column.IsComparable))
                                    {
                                        <th class="has-text-right">Aylık</th>
                                        <th class="@(field.IsNumeric ? "has-text-right" : null)">Kümülatif</th>
                                    }
                                </tr>
                            }
                        </thead>
                        <tbody>
                            @foreach (var row in detail.Rows)
                            {
                                <tr class="@GetWasteRowClass(row)" style="@GetWasteRowStyle(row)">
                                    <td>@row.SourceRowNumber</td>
                                    @if (detail.IncludeComparison)
                                    {
                                        <td>
                                            <span class="tag @(row.Comparison is null ? "is-warning is-light" : "is-success is-light")">
                                                @(row.Comparison is null ? "Bulunamadı" : "Eşleşti")
                                            </span>
                                        </td>
                                    }
                                    @foreach (var field in VisibleFields)
                                    {
                                        <td class="@(field.IsNumeric ? "has-text-right" : null)">@FormatField(field, row)</td>
                                        @if (detail.IncludeComparison && field.IsComparable)
                                        {
                                            <td class="@(field.IsNumeric ? "has-text-right" : null)">@FormatField(field, row.Comparison)</td>
                                        }
                                    }
                                    @if (CanCreateManualExcuse)
                                    {
                                        <td>
                                            <button class="button is-small is-warning is-light" type="button" @onclick="() => OpenExcuseRequest(row)">
                                                Mazeret iste
                                            </button>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <nav class="pagination is-small is-centered mt-5" role="navigation" aria-label="Sayfalama">
                    <button class="pagination-previous"
                            type="button"
                            disabled="@(isLoading || detail.PageNumber <= 1)"
                            @onclick="PreviousPageAsync">
                        Önceki
                    </button>
                    <button class="pagination-next"
                            type="button"
                            disabled="@(isLoading || detail.PageNumber >= detail.TotalPageCount)"
                            @onclick="NextPageAsync">
                        Sonraki
                    </button>
                    <ul class="pagination-list">
                        <li>
                            <span class="pagination-link is-current">
                                @detail.PageNumber / @detail.TotalPageCount
                            </span>
                        </li>
                        <li><span class="pagination-ellipsis">@detail.TotalRowCount.ToString("N0") satır</span></li>
                    </ul>
                </nav>
            }
        </section>
    }
</div>

@if (isFieldSelectorOpen)
{
    <div class="modal is-active" role="dialog" aria-modal="true" aria-labelledby="field-selector-title">
        <div class="modal-background" @onclick="CloseFieldSelector"></div>
        <div class="modal-card">
            <header class="modal-card-head">
                <p id="field-selector-title" class="modal-card-title">Gösterilecek alanlar</p>
                <button class="delete" type="button" aria-label="Kapat" @onclick="CloseFieldSelector"></button>
            </header>
            <section class="modal-card-body">
                <p class="mb-4 has-text-grey">
                    Tabloda görmek istediğiniz Excel alanlarını seçin. @SelectedFieldKeys.Count alan seçili.
                </p>
                <div class="columns is-multiline">
                    @foreach (var field in fields)
                    {
                        <div class="column is-half py-2">
                            <label class="checkbox">
                                <input class="mr-2"
                                       type="checkbox"
                                       checked="@SelectedFieldKeys.Contains(field.Key)"
                                       @onchange="eventArgs => ToggleField(field.Key, eventArgs)" />
                                @field.Label
                            </label>
                        </div>
                    }
                </div>
            </section>
            <footer class="modal-card-foot is-justify-content-space-between">
                <div class="buttons mb-0">
                    <button class="button is-light" type="button" @onclick="ResetDefaultFields">Önemli alanlar</button>
                    <button class="button is-light" type="button" @onclick="SelectAllFields">Tümünü seç</button>
                </div>
                <button class="button is-primary" type="button" @onclick="CloseFieldSelector">Uygula</button>
            </footer>
        </div>
    </div>
}

@if (pendingExcuseRow is not null)
{
    <div class="modal is-active" role="dialog" aria-modal="true" aria-labelledby="excuse-request-title">
        <div class="modal-background" @onclick="CloseExcuseRequest"></div>
        <div class="modal-card">
            <header class="modal-card-head">
                <p id="excuse-request-title" class="modal-card-title">@ManualExcuseTargetLabel için mazeret iste</p>
                <button class="delete" type="button" aria-label="Kapat" @onclick="CloseExcuseRequest"></button>
            </header>
            <section class="modal-card-body">
                @if (!string.IsNullOrWhiteSpace(manualExcuseError))
                {
                    <div class="notification is-danger is-light">@manualExcuseError</div>
                }
                <div class="notification is-light">
                    <p class="has-text-weight-semibold">@DisplayText(ManualExcuseTargetName)</p>
                    <p class="is-size-7 has-text-grey">@DisplayText(pendingExcuseRow.StoreName) · Depo No: @(pendingExcuseRow.StoreNumber?.ToString() ?? "–")</p>
                </div>
                <div class="field">
                    <label class="label">Talep notu</label>
                    <div class="control">
                        <textarea class="textarea" rows="5" maxlength="2000" placeholder="Mağazadan hangi konunun açıklanmasını istediğinizi yazın." @bind="manualExcuseNote"></textarea>
                    </div>
                    <p class="help">En az 5 karakter.</p>
                </div>
            </section>
            <footer class="modal-card-foot is-justify-content-flex-end">
                <button class="button is-light" type="button" disabled="@isCreatingExcuse" @onclick="CloseExcuseRequest">Vazgeç</button>
                <button class="button is-warning" type="button" disabled="@(isCreatingExcuse || manualExcuseNote.Trim().Length < 5)" @onclick="CreateManualExcuseAsync">
                    <span class="icon"><i class="fas fa-comment-dots"></i></span>
                    <span>Mazeret iste</span>
                </button>
            </footer>
        </div>
    </div>
}

@code {
    private const int DetailPageSize = 100;

    [Parameter]
    public long ImportId { get; set; }

    private readonly CancellationTokenSource cancellationTokenSource = new();
    private readonly ReportRowType[] rowTypes = Enum.GetValues<ReportRowType>()
        .Where(rowType => rowType != ReportRowType.General)
        .ToArray();
    private static readonly string[] importantMetricFieldKeys =
    [
        "storeSalesAmount",
        "costOfSales",
        "wasteRate",
        "wasteAmount",
        "profitAmount",
        "profitRate"
    ];
    private readonly DetailField[] fields =
    [
        new("sourceReportId", "rpr_id", row => row.SourceReportId.ToString("N0"), IsNumeric: true),
        new("sourceReportType", "rpr_tip", row => DisplayText(row.SourceReportType)),
        new("storeNumber", "Depo No", row => row.StoreNumber?.ToString("N0") ?? "–", IsNumeric: true),
        new("storeName", "Depo Adı", row => DisplayText(row.StoreName)),
        new("categoryCode", "Kategori Kodu", row => DisplayText(row.CategoryCode)),
        new("categoryName", "Kategori İsmi", row => DisplayText(row.CategoryName)),
        new("stockCode", "Stok Kodu", row => DisplayText(row.StockCode)),
        new("stockName", "Stok İsmi", row => DisplayText(row.StockName)),
        new("alternativeName", "Alternatif İsim", row => DisplayText(row.AlternativeName)),
        new("costGroupType", "Maliyet Grup Tipi", row => DisplayText(row.CostGroupType)),
        new("costGroupCode", "Maliyet Grup Kodu", row => DisplayText(row.CostGroupCode)),
        new("purchaseGroupValueFactor", "Satın Alma Grubu Değer Çarpanı", row => FormatNumber(row.PurchaseGroupValueFactor), IsNumeric: true),
        new("purchaseStockValueFactor", "Satın Alma Stok Değer Çarpanı", row => FormatNumber(row.PurchaseStockValueFactor), IsNumeric: true),
        new("openingQuantity", "Dönem Başı Miktar", row => FormatNumber(row.OpeningQuantity), IsNumeric: true, IsComparable: true),
        new("openingAmount", "Dönem Başı Tutar", row => FormatNumber(row.OpeningAmount), IsNumeric: true, IsComparable: true),
        new("companyPurchaseQuantity", "Firma Alış Miktar", row => FormatNumber(row.CompanyPurchaseQuantity), IsNumeric: true, IsComparable: true),
        new("companyPurchaseAmount", "Firma Alış Tutar", row => FormatNumber(row.CompanyPurchaseAmount), IsNumeric: true, IsComparable: true),
        new("warehouseTransferInQuantity", "Depo Sevk Alış Miktar", row => FormatNumber(row.WarehouseTransferInQuantity), IsNumeric: true, IsComparable: true),
        new("warehouseTransferInAmount", "Depo Sevk Alış Tutar", row => FormatNumber(row.WarehouseTransferInAmount), IsNumeric: true, IsComparable: true),
        new("warehouseTransferOutQuantity", "Depo Sevk Satış Miktar", row => FormatNumber(row.WarehouseTransferOutQuantity), IsNumeric: true, IsComparable: true),
        new("warehouseTransferOutAmount", "Depo Sevk Satış Tutar", row => FormatNumber(row.WarehouseTransferOutAmount), IsNumeric: true, IsComparable: true),
        new("storeSalesQuantity", "Mağaza Satış Miktar", row => FormatNumber(row.StoreSalesQuantity), IsNumeric: true, IsComparable: true),
        new("storeSalesAmount", "Mağaza Satış Tutar", row => FormatNumber(row.StoreSalesAmount), IsNumeric: true, IsComparable: true),
        new("costOfSales", "Satış Maliyeti", row => FormatNumber(row.CostOfSales), IsNumeric: true, IsComparable: true),
        new("wasteRate", "Fire Oranı", row => FormatRate(row.WasteRate), IsNumeric: true, IsComparable: true),
        new("wasteQuantity", "Fire Miktarı", row => FormatNumber(row.WasteQuantity), IsNumeric: true, IsComparable: true),
        new("wasteAmount", "Fire Tutarı", row => FormatNumber(row.WasteAmount), IsNumeric: true, IsComparable: true),
        new("closingQuantity", "Dönem Sonu Miktar", row => FormatNumber(row.ClosingQuantity), IsNumeric: true),
        new("closingAmount", "Dönem Sonu Tutar", row => FormatNumber(row.ClosingAmount), IsNumeric: true, IsComparable: true),
        new("profitAmount", "Kar Tutar", row => FormatNumber(row.ProfitAmount), IsNumeric: true, IsComparable: true),
        new("profitRate", "Kar Oran", row => FormatRate(row.ProfitRate), IsNumeric: true, IsComparable: true),
        new("categoryProfitRate", "Kategori Kar Oran", row => FormatRate(row.CategoryProfitRate), IsNumeric: true, IsComparable: true),
        new("categoryWasteRate", "Kategori Fire Oran", row => FormatRate(row.CategoryWasteRate), IsNumeric: true, IsComparable: true)
    ];
    private readonly Dictionary<ReportRowType, HashSet<string>> selectedFieldKeysByRowType = [];
    private ClaimsPrincipal currentUser = new(new ClaimsIdentity());
    private ReportDetailResult? detail;
    private ReportRowType selectedRowType = ReportRowType.CategorySummary;
    private ReportDetailFilter filters = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading;
    private bool compareWithCumulative;
    private bool isGeneralSummaryExpanded = true;
    private bool isFieldSelectorOpen;
    private bool canRequestExcuses;
    private ReportDetailRowItem? pendingExcuseRow;
    private string manualExcuseNote = string.Empty;
    private string? manualExcuseError;
    private bool isCreatingExcuse;

    private bool CanCreateManualExcuse =>
        canRequestExcuses &&
        detail?.Header.PeriodType == ReportPeriodType.Monthly &&
        detail.Header.IsActive &&
        selectedRowType is ReportRowType.StoreCategory or ReportRowType.StoreProduct;

    private string ManualExcuseTargetLabel =>
        selectedRowType == ReportRowType.StoreProduct ? "Ürün" : "Alt kategori";

    private string? ManualExcuseTargetName => selectedRowType == ReportRowType.StoreProduct
        ? pendingExcuseRow?.StockName ?? pendingExcuseRow?.StockCode
        : pendingExcuseRow?.CategoryName ?? pendingExcuseRow?.CategoryCode;

    private HashSet<string> SelectedFieldKeys
    {
        get
        {
            if (selectedFieldKeysByRowType.TryGetValue(selectedRowType, out var selectedKeys))
            {
                return selectedKeys;
            }

            selectedKeys = new HashSet<string>(GetDefaultFieldKeys(selectedRowType), StringComparer.Ordinal);
            selectedFieldKeysByRowType[selectedRowType] = selectedKeys;
            return selectedKeys;
        }
    }

    private IEnumerable<DetailField> VisibleFields =>
        fields.Where(column => SelectedFieldKeys.Contains(column.Key));

    private bool ShowComparisonSubheaders =>
        detail?.IncludeComparison == true && VisibleFields.Any(column => column.IsComparable);

    private bool ShowStoreFilter => selectedRowType is
        ReportRowType.StoreSummary or ReportRowType.StoreCategory or ReportRowType.StoreProduct;

    private bool ShowCategoryFilter => selectedRowType is
        ReportRowType.CategorySummary or ReportRowType.StoreCategory or ReportRowType.StoreProduct;

    private bool ShowProductFilter => selectedRowType is
        ReportRowType.ProductSummary or ReportRowType.StoreProduct;

    private int ActiveFilterCount =>
        CountFilter(filters.SearchText) +
        CountFilter(ShowStoreFilter ? filters.StoreText : null) +
        CountFilter(ShowCategoryFilter ? filters.CategoryText : null) +
        CountFilter(ShowProductFilter ? filters.ProductText : null) +
        (filters.WasteFilter == ReportDetailWasteFilter.All ? 0 : 1) +
        (filters.ComparisonFilter == ReportDetailComparisonFilter.All ? 0 : 1) +
        (filters.MinimumWasteRate.HasValue ? 1 : 0) +
        (filters.MaximumWasteRate.HasValue ? 1 : 0);

    private bool HasFilterChanges =>
        ActiveFilterCount > 0 || filters.Sort != ReportDetailSort.SourceOrder || HasAppliedFilters;

    private bool HasAppliedFilters => detail is not null &&
        (HasFilters(detail.Filters) || detail.Filters.Sort != ReportDetailSort.SourceOrder);

    private void ToggleGeneralSummary() => isGeneralSummaryExpanded = !isGeneralSummaryExpanded;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        currentUser = (await StateProvider.GetAuthenticationStateAsync()).User;

        if (currentUser.Identity?.IsAuthenticated == true)
        {
            canRequestExcuses = (await AuthorizationService.AuthorizeAsync(
                currentUser,
                ReportPolicies.CanRequestExcuses)).Succeeded;
            await LoadDetailAsync(1);
        }
    }

    private async Task LoadDetailAsync(int pageNumber)
    {
        if (isLoading)
        {
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            detail = await ReportImportService.GetDetailAsync(
                ImportId,
                selectedRowType,
                filters,
                pageNumber,
                DetailPageSize,
                compareWithCumulative,
                currentUser,
                cancellationTokenSource.Token);
            filters = CloneFilters(detail.Filters);
            compareWithCumulative = detail.IncludeComparison;
        }
        catch (OperationCanceledException) when (cancellationTokenSource.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            errorMessage = GetUserMessage(exception);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenExcuseRequest(ReportDetailRowItem row)
    {
        pendingExcuseRow = row;
        manualExcuseNote = string.Empty;
        manualExcuseError = null;
        errorMessage = null;
        successMessage = null;
    }

    private void CloseExcuseRequest()
    {
        if (isCreatingExcuse) return;
        pendingExcuseRow = null;
        manualExcuseNote = string.Empty;
        manualExcuseError = null;
    }

    private async Task CreateManualExcuseAsync()
    {
        if (pendingExcuseRow is null || isCreatingExcuse) return;
        isCreatingExcuse = true;
        manualExcuseError = null;
        successMessage = null;

        try
        {
            var excuseId = await ExcuseService.CreateManualRequestAsync(
                pendingExcuseRow.Id,
                manualExcuseNote,
                currentUser,
                cancellationTokenSource.Token);
            NavigationManager.NavigateTo($"/mazeretler/{excuseId}");
        }
        catch (OperationCanceledException) when (cancellationTokenSource.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            manualExcuseError = exception.Message;
        }
        finally
        {
            isCreatingExcuse = false;
        }
    }

    private async Task SelectRowTypeAsync(ReportRowType rowType)
    {
        if (selectedRowType == rowType || isLoading)
        {
            return;
        }

        selectedRowType = rowType;
        filters = new ReportDetailFilter();
        await LoadDetailAsync(1);
    }

    private Task ApplyFiltersAsync() => LoadDetailAsync(1);

    private async Task HandleFilterKeyDown(KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key == "Enter" && !isLoading)
        {
            await ApplyFiltersAsync();
        }
    }

    private async Task ToggleComparisonAsync(ChangeEventArgs eventArgs)
    {
        if (isLoading)
        {
            return;
        }

        compareWithCumulative = eventArgs.Value is bool isChecked && isChecked;
        await LoadDetailAsync(1);
    }

    private async Task ClearFiltersAsync()
    {
        filters = new ReportDetailFilter();
        await LoadDetailAsync(1);
    }

    private void OpenFieldSelector() => isFieldSelectorOpen = true;
    private void CloseFieldSelector() => isFieldSelectorOpen = false;

    private void ToggleField(string fieldKey, ChangeEventArgs eventArgs)
    {
        if (eventArgs.Value is bool isChecked && isChecked)
        {
            SelectedFieldKeys.Add(fieldKey);
            return;
        }

        SelectedFieldKeys.Remove(fieldKey);
    }

    private void SelectAllFields()
    {
        foreach (var field in fields)
        {
            SelectedFieldKeys.Add(field.Key);
        }
    }

    private void ResetDefaultFields()
    {
        SelectedFieldKeys.Clear();

        foreach (var fieldKey in GetDefaultFieldKeys(selectedRowType))
        {
            SelectedFieldKeys.Add(fieldKey);
        }
    }

    private Task PreviousPageAsync() => detail is null ? Task.CompletedTask : LoadDetailAsync(detail.PageNumber - 1);
    private Task NextPageAsync() => detail is null ? Task.CompletedTask : LoadDetailAsync(detail.PageNumber + 1);

    private static string DisplayText(string? value) => string.IsNullOrWhiteSpace(value) ? "–" : value;
    private static int CountFilter(string? value) => string.IsNullOrWhiteSpace(value) ? 0 : 1;
    private static bool HasFilters(ReportDetailFilter value) =>
        !string.IsNullOrWhiteSpace(value.SearchText) ||
        !string.IsNullOrWhiteSpace(value.StoreText) ||
        !string.IsNullOrWhiteSpace(value.CategoryText) ||
        !string.IsNullOrWhiteSpace(value.ProductText) ||
        value.WasteFilter != ReportDetailWasteFilter.All ||
        value.ComparisonFilter != ReportDetailComparisonFilter.All ||
        value.MinimumWasteRate.HasValue ||
        value.MaximumWasteRate.HasValue;

    private static ReportDetailFilter CloneFilters(ReportDetailFilter value) => new()
    {
        SearchText = value.SearchText,
        StoreText = value.StoreText,
        CategoryText = value.CategoryText,
        ProductText = value.ProductText,
        WasteFilter = value.WasteFilter,
        ComparisonFilter = value.ComparisonFilter,
        MinimumWasteRate = value.MinimumWasteRate,
        MaximumWasteRate = value.MaximumWasteRate,
        Sort = value.Sort
    };

    private static string FormatNumber(decimal? value) => value?.ToString("N2") ?? "–";
    private static string FormatRate(decimal? value) => value is null ? "–" : $"% {value:N2}";

    private static string? GetWasteRowClass(ReportDetailRowItem row) =>
        row.WasteRate < 0m || row.WasteAmount < 0m ? "waste-loss-row" : null;

    private string? GetWasteRowStyle(ReportDetailRowItem row)
    {
        if (row.WasteRate is not < 0m && row.WasteAmount is not < 0m)
        {
            return null;
        }

        var wasteMagnitude = Math.Abs(row.WasteRate ?? 0m);
        var generalWasteMagnitude = Math.Abs(detail?.Header.GeneralSummary?.WasteRate ?? 0m);
        var thresholdMultiplier = Math.Max(ExcuseOptions.Value.ThresholdMultiplier, 0m);
        var thresholdMagnitude = generalWasteMagnitude * thresholdMultiplier;

        var progress = thresholdMagnitude > 0m
            ? Math.Min(wasteMagnitude / thresholdMagnitude, 2.5m) / 2.5m
            : 0.2m;
        var backgroundAlpha = 0.035m + (0.185m * progress);
        var accentAlpha = Math.Min(0.25m + (0.55m * progress), 0.80m);

        return FormattableString.Invariant(
            $"--waste-background-alpha: {backgroundAlpha:F3}; --waste-accent-alpha: {accentAlpha:F3}");
    }

    private string FormatField(DetailField field, ReportDetailRowItem? row)
    {
        if (row is null)
        {
            return "–";
        }

        return IsRollupField(selectedRowType, field.Key) ? "Tümü" : field.GetValue(row);
    }

    private static string[] GetDefaultFieldKeys(ReportRowType rowType) => rowType switch
    {
        ReportRowType.General => [.. importantMetricFieldKeys],
        ReportRowType.CategorySummary => ["categoryCode", "categoryName", .. importantMetricFieldKeys],
        ReportRowType.StoreSummary => ["storeNumber", "storeName", .. importantMetricFieldKeys],
        ReportRowType.StoreCategory =>
        [
            "storeNumber", "storeName", "categoryCode", "categoryName", .. importantMetricFieldKeys
        ],
        ReportRowType.ProductSummary => ["stockCode", "stockName", .. importantMetricFieldKeys],
        ReportRowType.StoreProduct =>
        [
            "storeNumber", "storeName", "categoryCode", "categoryName", "stockCode", "stockName",
            .. importantMetricFieldKeys
        ],
        _ => [.. importantMetricFieldKeys]
    };

    private static bool IsRollupField(ReportRowType rowType, string fieldKey) => rowType switch
    {
        ReportRowType.General =>
            IsStoreField(fieldKey) || IsCategoryField(fieldKey) || IsStockField(fieldKey) ||
            IsAlternativeNameField(fieldKey) || IsCostGroupField(fieldKey),
        ReportRowType.CategorySummary =>
            IsStoreField(fieldKey) || IsStockField(fieldKey) || IsAlternativeNameField(fieldKey) ||
            IsCostGroupField(fieldKey),
        ReportRowType.StoreSummary =>
            IsCategoryField(fieldKey) || IsStockField(fieldKey) || IsAlternativeNameField(fieldKey) ||
            IsCostGroupField(fieldKey),
        ReportRowType.StoreCategory =>
            IsStockField(fieldKey) || IsAlternativeNameField(fieldKey) || IsCostGroupField(fieldKey),
        ReportRowType.ProductSummary =>
            IsStoreField(fieldKey) || IsCategoryField(fieldKey) || IsCostGroupField(fieldKey),
        _ => false
    };

    private static bool IsStoreField(string fieldKey) => fieldKey is "storeNumber" or "storeName";
    private static bool IsCategoryField(string fieldKey) => fieldKey is "categoryCode" or "categoryName";
    private static bool IsStockField(string fieldKey) => fieldKey is "stockCode" or "stockName";
    private static bool IsAlternativeNameField(string fieldKey) => fieldKey == "alternativeName";
    private static bool IsCostGroupField(string fieldKey) => fieldKey is "costGroupType" or "costGroupCode";

    private static string GetUserMessage(Exception exception) => exception switch
    {
        ReportNotFoundException => exception.Message,
        UnauthorizedAccessException => exception.Message,
        _ => "Rapor detayları yüklenirken beklenmeyen bir hata oluştu."
    };

    public ValueTask DisposeAsync()
    {
        cancellationTokenSource.Cancel();
        cancellationTokenSource.Dispose();
        GC.SuppressFinalize(this);
        return ValueTask.CompletedTask;
    }

    private sealed record DetailField(
        string Key,
        string Label,
        Func<ReportDetailRowItem, string> GetValue,
        bool IsNumeric = false,
        bool IsComparable = false);
}
