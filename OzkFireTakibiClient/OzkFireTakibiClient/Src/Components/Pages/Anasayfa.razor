@inherits OzkFireTakibiClient.Src.Components.Controls.AuthRequiredComponent

<PageTitle>Anasayfa</PageTitle>

<div class="container mt-4">
    <div class="card p-4 shadow-sm">
        <h1 class="h2">Hoş Geldiniz, @UserName</h1>
        <p class="text-muted">Kullanıcı Rolü: <span class="badge bg-primary">@UserRole</span></p>
        <p>Ozk Fire Takibi uygulamasına başarıyla giriş yaptınız.</p>
    </div>
</div>
