@page "/giris"
@layout EmptyLayout

@using System.ComponentModel.DataAnnotations
@using OzkFireTakibiClient.Src.Services

@inject LoginService LoginService

<PageTitle>Giriş Yap</PageTitle>

<section class="hero is-fullheight login-hero">
    <div class="hero-body">
        <div class="container">
            <div class="columns is-centered">
                <div class="column is-5-tablet is-4-desktop is-3-widescreen">
                    <div class="has-text-centered mb-5">
                        <div class="login-logo-container mb-3">
                            <i class="fas fa-fire-flame-curved fa-2x has-text-primary"></i>
                        </div>
                        <h1 class="title is-4 has-text-dark">ÖZK Fire Takibi</h1>
                        <p class="subtitle is-6 has-text-grey">Lütfen hesabınıza giriş yapın</p>
                    </div>

                    <div class="box login-box p-5">
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="notification is-danger is-light py-2 px-3 mb-4 is-size-7" role="alert">
                                <button class="delete is-small" @onclick="() => errorMessage = null"></button>
                                <i class="fas fa-circle-exclamation mr-1"></i>
                                @errorMessage
                            </div>
                        }

                        <EditForm Model="@loginModel" OnValidSubmit="@HandleValidSubmit" FormName="LoginForm">
                            <DataAnnotationsValidator />

                            <div class="field mb-4">
                                <label for="email" class="label is-small">E-posta</label>
                                <div class="control has-icons-left">
                                    <InputText id="email" class="input" type="email" placeholder="ornek@firma.com" @bind-Value="loginModel.Email" />
                                    <span class="icon is-small is-left">
                                        <i class="fas fa-envelope"></i>
                                    </span>
                                </div>
                                <ValidationMessage For="@(() => loginModel.Email)" class="help is-danger" />
                            </div>

                            <div class="field mb-4">
                                <label for="password" class="label is-small">Şifre</label>
                                <div class="control has-icons-left">
                                    <InputText id="password" type="password" class="input" placeholder="••••••••" @bind-Value="loginModel.Password" />
                                    <span class="icon is-small is-left">
                                        <i class="fas fa-lock"></i>
                                    </span>
                                </div>
                                <ValidationMessage For="@(() => loginModel.Password)" class="help is-danger" />
                            </div>

                            <div class="field mb-5">
                                <div class="control">
                                    <label class="checkbox is-size-7 is-flex is-align-items-center">
                                        <InputCheckbox id="rememberMe" class="mr-2" @bind-Value="loginModel.RememberMe" />
                                        Beni Hatırla
                                    </label>
                                </div>
                            </div>

                            <div class="field">
                                <div class="control">
                                    <button type="submit" class="button is-primary is-fullwidth @(isProcessing ? "is-loading" : "")" disabled="@isProcessing">
                                        <span>Giriş Yap</span>
                                    </button>
                                </div>
                            </div>
                        </EditForm>
                    </div>

                    <p class="has-text-grey has-text-centered is-size-7 mt-4">
                        &copy; @DateTime.Now.Year ÖZK Fire Takip Sistemi
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .login-hero {
        background-color: #f4f6f9 !important;
        min-height: 100vh;
    }

    .login-logo-container {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background-color: rgba(0, 209, 178, 0.12);
    }

    .login-box {
        background-color: #ffffff !important;
        border: 1px solid #e8ecf1 !important;
        border-radius: 12px !important;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.06) !important;
    }

    .login-box .label {
        color: #363636 !important;
        font-weight: 600;
    }

    .login-box .input {
        background-color: #ffffff !important;
        color: #363636 !important;
        border-color: #dbdbdb !important;
        border-radius: 6px !important;
        box-shadow: inset 0 1px 2px rgba(10, 10, 10, 0.05);
    }

    .login-box .input:focus {
        border-color: #00d1b2 !important;
        box-shadow: 0 0 0 0.125em rgba(0, 209, 178, 0.25) !important;
    }

    .login-box .icon {
        color: #7a7a7a !important;
    }

    .login-box .checkbox {
        color: #4a4a4a !important;
    }

    h1:focus, .title:focus {
        outline: none !important;
    }
</style>

@code {
    [SupplyParameterFromForm]
    private LoginModel loginModel { get; set; } = default!;
    private string? errorMessage;
    private bool isProcessing;

    protected override void OnInitialized()
    {
        loginModel ??= new();
    }

    private async Task HandleValidSubmit()
    {

        errorMessage = null;
        isProcessing = true;

        try
        {
            var success = await LoginService.LoginAsync(loginModel.Email, loginModel.Password, loginModel.RememberMe);
            if (!success)
            {
                errorMessage = "E-posta veya şifre hatalı.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Giriş işlemi sırasında beklenmeyen bir hata oluştu.";
        }
        finally
        {
            isProcessing = false;
        }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "E-posta adresi gereklidir.")]
        [EmailAddress(ErrorMessage = "Geçerli bir e-posta adresi giriniz.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Şifre gereklidir.")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
